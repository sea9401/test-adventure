# Vercel Marketplace 통합이 자동 주입하는 변수들. 로컬 개발 시:
#   $ vercel env pull .env.development.local
# 으로 실제 값을 받아온다. 이 파일은 어떤 변수가 필요한지 보여주는 참조용.

# Auth.js (NextAuth) — https://authjs.dev/getting-started/installation
# 32자 이상 랜덤 문자열. `openssl rand -base64 32` 로 생성.
AUTH_SECRET=your_auth_secret_here

# Google OAuth — Google Cloud Console에서 발급.
# Callback URL: {domain}/api/auth/callback/google
AUTH_GOOGLE_ID=your_google_client_id
AUTH_GOOGLE_SECRET=your_google_client_secret

# Kakao OAuth — https://developers.kakao.com 에서 발급.
# Callback URL: {domain}/api/auth/callback/kakao
AUTH_KAKAO_ID=your_kakao_rest_api_key
AUTH_KAKAO_SECRET=your_kakao_client_secret

# Neon Postgres (Vercel Marketplace → Neon → Install)
DATABASE_URL=postgres://user:pass@ep-xxx.neon.tech/dbname?sslmode=require

# /admin 페이지 접근 허용 이메일 (콤마 구분, OAuth 계정의 이메일과 매칭).
# 비어있으면 모든 사용자가 차단된다 (404).
ADMIN_EMAILS=you@example.com

# 서버 전역 EXP 배율 — 테스트 서버에서 5 같이 두면 사냥/퀘스트 EXP ×5.
# 신참 ×2 / 길드 expMult 와는 곱해짐 (예: 5 × 2 = ×10). 미설정/파싱 실패 시 1.
# 빌드 타임 주입 — 변경하려면 재빌드 필요. 안전 범위 [0.1, 100].
NEXT_PUBLIC_XP_RATE_MULT=1

# 길드 영지(별빛 권역) 시스템 토글 — 기본 OFF. true 일 때만 "영주의 회관" 노드 진입 가능.
# OFF 일 때도 노드는 별빛 맵에 보이지만, 진입 카드가 "곧 공개됩니다" 로 표시되고 subView 전이가 막힘.
# 본토 플레이어 경험은 OFF/ON 무관하게 동일.
NEXT_PUBLIC_FIEFDOM_ENABLED=false

# v2 코어 루프 재설계 마스터 플래그 — 기본 OFF. true 일 때만 V1식 사냥(스태미나 폐지·전투
# 쿨다운·오프라인 정산)·평탄 스탯게이트 직업 트리·재전직·패배 세금·협동보스 무료공격이
# 켜진다. 빌드타임에 클라/서버 번들 양쪽에 구워짐(NEXT_PUBLIC). 미설정 환경은 현행과
# byte-identical. 스테이징에서 먼저 켜 검증 후 프로덕션 env 에 추가로 flip.
NEXT_PUBLIC_V2_CORE_LOOP_V2=false

# ATB 전투에서 v2 직업 액티브 스킬 시전 활성화(applyPlayerV2SkillCast / castV2SkillOnAttackerTurnPvP).
# 미설정/false = 라이브 byte-identical(스킬 미발동). 스테이징서 먼저 켜 검증 후 프로덕션 flip.
NEXT_PUBLIC_V2_ATB_SKILLS=false

# 스테이징(테스트 서버) 환경 표식. true 일 때만 middleware 의 staging 게이트가 작동.
# prod 에선 미설정. 라이브와 동일 코드라도 이 값이 다르면 양 환경 분기됨.
IS_STAGING=false

# 스테이징 게이트 열림 여부. STAGING_OPEN=true 면 정상 작동(테스트 기간).
# false/미설정이면 모든 요청이 /staging-closed 로 rewrite 되어 "운영중이지 않습니다" 페이지가 떠.
# 라이브 가까이에 있는 코드 검증 끝나면 STAGING_OPEN=true 로 두고, 평소엔 false.
STAGING_OPEN=false
