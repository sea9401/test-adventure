# 환경변수 참조용 — 어떤 변수가 필요한지 보여주는 예시 파일.
# 실제 비밀값은 각 박스(EC2)의 .env.production.local / 로컬의 .env.development.local 에 둔다(git 미추적).
# 라이브 빌드 플래그의 실값과 상세 설명은 .env.production(git 추적) 참조.

# Auth.js (NextAuth) — 32자 이상 랜덤 문자열. `openssl rand -base64 32` 로 생성.
AUTH_SECRET=your_auth_secret_here

# 홍보 보상 중복 방지 식별자 HMAC 키 — 32자 이상 별도 랜덤 문자열.
# AUTH_SECRET과 독립적으로 유지하며 이벤트 원장 보유 중에는 회전하지 않는다.
REFERRAL_IDENTITY_SECRET=your_referral_identity_secret_here

# Kakao OAuth — https://developers.kakao.com 에서 발급.
# Callback URL: {domain}/api/auth/callback/kakao
AUTH_KAKAO_ID=your_kakao_rest_api_key
AUTH_KAKAO_SECRET=your_kakao_client_secret

# 심사용 아이디/비밀번호 로그인 — 세 값을 모두 설정해야 활성화.
# REVIEW_LOGIN_USER_EMAIL 은 카카오 로그인을 마친 기존 users.email 이어야 하며
# 새 사용자를 만들지 않는다.
REVIEW_LOGIN_ID=
REVIEW_LOGIN_PASSWORD=
REVIEW_LOGIN_USER_EMAIL=

# 로컬 개발 자동 로그인 — `npm run dev` + loopback 접속에서만 활성화.
# 현재 DATABASE_URL의 개발 DB에 이미 존재하는 users.email을 지정한다.
# 운영 DB를 로컬 개발 서버에 직접 연결하지 않는다.
LOCAL_DEV_AUTO_LOGIN_USER_EMAIL=

# Postgres (AWS RDS) — 앱이 TLS 인증서와 호스트명을 검증한다.
# AWS 공식 global-bundle.pem을 EC2에 설치하고 절대 경로를 지정한다.
# 마이그레이션은 배포 파이프라인이 자동 실행한다.
DATABASE_URL=postgres://user:pass@your-rds-host:5432/dbname
DATABASE_CA_CERT_PATH=/etc/pki/rds/global-bundle.pem

# /admin 페이지 접근 허용 이메일 (콤마 구분, OAuth 계정의 이메일과 매칭).
# 비어있으면 모든 사용자가 차단된다 (404).
ADMIN_EMAILS=you@example.com

# 관리자 계정 가장. 스테이징(IS_STAGING=true)은 자동 허용.
# 운영은 두 값을 모두 true로 두어야 작동(실제 대상 유저 진척에 쓰기 발생).
ADMIN_IMPERSONATION_ENABLED=false
ALLOW_PRODUCTION_ADMIN_IMPERSONATION=false

# 크론 라우트 인증 토큰 — EC2 crontab 의 curl 이 `Authorization: Bearer` 로 보낸다.
CRON_SECRET=your_cron_secret_here

# Web Push VAPID 키 — `npx web-push generate-vapid-keys`로 한 쌍을 생성한다.
# PRIVATE 키는 SSM SecureString에만 저장하고 저장소에 커밋하지 않는다.
WEB_PUSH_VAPID_PUBLIC_KEY=your_vapid_public_key
WEB_PUSH_VAPID_PRIVATE_KEY=your_vapid_private_key
WEB_PUSH_SUBJECT=mailto:support@msmsge.com

# 개인 홍보 링크를 통해 신규 캐릭터 생성이 완료됐을 때 홍보자에게 지급할 골드.
# 생략하거나 잘못된 값이면 10000, 0이면 실적만 기록하고 보상 우편은 보내지 않는다.
REFERRAL_REWARD_GOLD=10000

# 운영 경보 수신 webhook. 앱 이상 신호·일일 리포트·크론 실패가 이 주소로 전송된다.
OPS_ALERT_WEBHOOK_URL=https://your-webhook.example/ops

# 점검 모드 — true 면 middleware 가 점검 페이지로 rewrite. 박스 .env.production.local 에서 토글.
MAINTENANCE_MODE=false

# 서버 전역 EXP 배율 — 미설정/파싱 실패 시 코어 루프 기본값 적용. 빌드 타임 주입(변경=재빌드).
NEXT_PUBLIC_XP_RATE_MULT=1

# 스테이징(테스트 서버) 표식/게이트 — prod 에선 미설정. 운영 배포 사전검사는 true를 거부한다.
# IS_STAGING=true 빌드에만 /dev 프리뷰 포함.
# STAGING_OPEN=false 면 모든 요청이 /staging-closed 로 rewrite.
IS_STAGING=false
STAGING_OPEN=false

# ── v2 라이브 플래그 (전부 NEXT_PUBLIC_ = 빌드타임 베이크, 값 변경 시 재빌드 필수) ──
# 운영 실값·상세 설명은 .env.production 참조. 관례: 스테이징에서 먼저 켜 검증 후 prod flip.
NEXT_PUBLIC_V2_CORE_LOOP_V2=false
NEXT_PUBLIC_V2_HUNT_USE_STAMINA=false
NEXT_PUBLIC_V2_ATB_SKILLS=false
NEXT_PUBLIC_V2_SKILL_PROC_IN_PATTERN=false
NEXT_PUBLIC_V2_SETTLEMENT_WARFARE=false
NEXT_PUBLIC_V2_TILE_WARFARE=false
NEXT_PUBLIC_V2_TILE_PRODUCTION=false
NEXT_PUBLIC_V2_FREEFORM_TILES=false
NEXT_PUBLIC_V2_EQUIPMENT_LIBERATION=false

# 무슨 코인 상점 공개 여부. false 면 메뉴에서 숨기고 직접 주소도 404 처리한다.
# 결제 기능과 고지·환불 정책을 확정한 뒤 true 로 바꾸고 재빌드한다.
NEXT_PUBLIC_MUSEUN_COIN_SHOP_OPEN=false
# 공개 전 상점 접근을 허용할 심의용 비밀번호 로그인 ID(콤마 구분).
# 미설정 시 gcrb-review-01~03만 허용되며 ADMIN_EMAILS 계정도 촬영용으로 허용한다.
MUSEUN_COIN_SHOP_REVIEW_LOGIN_IDS=gcrb-review-01,gcrb-review-02,gcrb-review-03
# 위 계정들의 users.id. Proxy가 DB 조회 없이 허용 계정만 통과시키는 데 사용한다.
MUSEUN_COIN_SHOP_REVIEW_USER_IDS=

# 장시간 생활 콘텐츠 반복 시 관리형 사람 확인. 둘 다 설정해야 enforcement 활성.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAMES=msmsge.com,www.msmsge.com

# 강한 자동화 의심 신호에만 Turnstile 다음 단계로 표시. 두 키를 함께 설정.
# 호스트 목록을 생략하면 TURNSTILE_EXPECTED_HOSTNAMES를 재사용한다.
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=
HCAPTCHA_EXPECTED_HOSTNAMES=msmsge.com,www.msmsge.com

# 길드 엠블럼 저장소 — Cloudflare R2의 S3 API 토큰(객체 읽기/쓰기 권한).
# 네 값을 모두 설정해야 업로드와 이미지 표시가 활성화된다. 버킷은 비공개여도 된다.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=adventure-guild-emblems

# DB 덤프 외부 보관 위치. EC2 IAM 역할에 해당 prefix PutObject 권한을 부여한다.
BACKUP_S3_URI=s3://your-backup-bucket/adventure-rpg
