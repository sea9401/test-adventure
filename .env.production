# 라이브(prod) 전용 — git 추적되는 공개 빌드 설정. 비밀은 박스의 .env.production.local 에.
# Next.js 빌드 시 .env.production.local > .env.local > .env.production 순으로 로드되므로,
# 박스 .env.production.local 에 같은 키가 없으면 여기 값이 빌드에 적용된다.

# 코어 루프 재설계 마스터 플래그. true 면 재설계 전체 ON — V1식 사냥(스태미나 폐지·전투당
# 딜레이·오프라인 자동사냥) + ATB 전투 + SP 스킬 로드아웃 + 재전직 루프 + 은행/패배세금.
# flag-off 는 옛 코어 루프(스태미나)로 복귀 — learned/세이브 보존. NEXT_PUBLIC_ 라 빌드타임
# 베이크 — 값 변경 시 재빌드 필수.
# 2026-06-16 운영 승격(true) → 2026-06-19 되돌림(false): 오프라인 자동전투 체감 불만(지는
#   사냥터도 방치 시 보상)으로 스태미나 형식 전투로 복귀(사용자 결정). XP 도 옛 4.0 복원(아래).
NEXT_PUBLIC_V2_CORE_LOOP_V2=false

# 직업 시스템 v2 재설계 마스터 플래그 (2026-06-16 운영 승격). true 면 직업 트리/전직/전투가
# 새 카탈로그(13직업·cumLevel 해금·직업 보너스 플랫·점진 공개 UI)로 동작 — 옛 직군/계파
# 스탯게이트 대체. 세이브는 옛 class+specChoice 그대로 두고 jobIdFromLegacy 가 해석 시점에
# 변환(브리지 영구) — flag-off 는 바이트 동일·세이브 보존. 사라진 4계파(검투사·연환·워메이지·
# 독사)는 흡수 상위 직업으로 자동 정규화. NEXT_PUBLIC_ 라 빌드타임 베이크 — 값 변경 시 재빌드
# 필수. 되돌리려면 false/제거 후 재배포.
NEXT_PUBLIC_V2_JOB_SYSTEM_V2=true

# 전역 EXP 배율 (leveling.ts XP_RATE_MULT). 코어 루프 되돌림(2026-06-19)으로 옛 라이브 가속
# 4.0 복원 — flag-off 면 미설정 시 1.0 으로 떨어지므로 명시 필요(되돌리려면 1 로).
# ⚠️ 박스 .env.production.local 에 NEXT_PUBLIC_XP_RATE_MULT 가 있으면 그게 우선 — 4.0 적용하려면
#    .local 의 값을 확인(없거나 4 여야 함).
NEXT_PUBLIC_XP_RATE_MULT=4
