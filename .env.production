# 라이브(prod) 전용 — git 추적되는 공개 빌드 설정. 비밀은 박스의 .env.production.local 에.
# Next.js 빌드 시 .env.production.local > .env.local > .env.production 순으로 로드되므로,
# 박스 .env.production.local 에 같은 키가 없으면 여기 값이 빌드에 적용된다.

# 코어 루프 재설계 마스터 플래그 (2026-06-16 운영 승격). true 면 재설계 전체 ON —
# V1식 사냥(스태미나 폐지·전투당 딜레이·오프라인 자동사냥) + ATB 전투 + SP 스킬 로드아웃
# + 재전직 루프 + 은행/패배세금. 되돌리려면 false/제거 후 재배포 (flag-off 는 바이트 동일·
# learned/세이브 보존). NEXT_PUBLIC_ 라 빌드타임 베이크 — 값 변경 시 재빌드 필수.
NEXT_PUBLIC_V2_CORE_LOOP_V2=true

# 사냥 throttle 스태미나 모드 (2026-06-19 운영 적용). true 면 코어 루프는 유지하되 사냥만
# 옛 스태미나 차감/재생으로 — 전투당 쿨다운·오프라인 자동전투 폐지(직업/SP/ATB/재전직/은행은
# 그대로). 사용자 결정: 오프라인 자동전투 체감 불만(지는 사냥터도 방치 시 보상)으로 사냥만 복귀.
# 미설정/false = 쿨다운 모드(코어루프 원안). NEXT_PUBLIC_ 라 빌드타임 베이크 — 값 변경 시 재빌드.
NEXT_PUBLIC_V2_HUNT_USE_STAMINA=true

# ATB 전투 v2 스킬 시전 (2026-06-20). true 면 라이브 ATB(PvE+PvP)에서 직업 액티브 스킬이 발동한다.
# 그동안 cast 가 legacy 루프에만 있어 ATB(=라이브)에선 모든 직업 액티브가 죽어 있었다(패시브만 작동).
# 켜면 원소술사 속성마법(바람=가속·대지=지연·불=화상치유감소) 포함 모든 직업 액티브가 처음 발동 —
# 큰 밸런스 변화이므로 스테이징(test.msmsge.com)서 먼저 켜 /admin 텔레메트리 검증 후 프로덕션 flip.
# 미설정/false = 바이트 동일·미발동. NEXT_PUBLIC_ 라 빌드타임 베이크 — 값 변경 시 재빌드 필수.
NEXT_PUBLIC_V2_ATB_SKILLS=true

# 패턴(갬빗) 경로 스킬 발동확률 부활 (2026-06-20). 갬빗 재설계가 "조건 충족 = 확정 발동" 으로
# procChance 를 은퇴시키면서, 카탈로그의 정교한 발동확률(강타 10%·방패막기 60% 등)이 라이브에서
# 죽은 데이터가 되고 고위력 스킬도 MP만 되면 매 턴 발동하던 문제. true 면 패턴이 고른 스킬도
# procChance 게이트를 통과해야 발동(확정 발동 → 확률 발동). 큰 밸런스 변화이므로 스테이징서 켜
# 검증 후 프로덕션 flip. 미설정/false = 패턴 경로 바이트 동일(은퇴 유지). NEXT_PUBLIC_ 빌드 베이크.
NEXT_PUBLIC_V2_SKILL_PROC_IN_PATTERN=true

# 직업 시스템 v2 재설계 마스터 플래그 (2026-06-16 운영 승격). true 면 직업 트리/전직/전투가
# 새 카탈로그(13직업·cumLevel 해금·직업 보너스 플랫·점진 공개 UI)로 동작 — 옛 직군/계파
# 스탯게이트 대체. 세이브는 옛 class+specChoice 그대로 두고 jobIdFromLegacy 가 해석 시점에
# 변환(브리지 영구) — flag-off 는 바이트 동일·세이브 보존. 사라진 4계파(검투사·연환·워메이지·
# 독사)는 흡수 상위 직업으로 자동 정규화. NEXT_PUBLIC_ 라 빌드타임 베이크 — 값 변경 시 재빌드
# 필수. 되돌리려면 false/제거 후 재배포.
NEXT_PUBLIC_V2_JOB_SYSTEM_V2=true

# 정착지 전쟁(방어/PvP) 마스터 플래그 (2026-06-21 운영 flip). true 면 정착지 마을을 약탈/정복하고
# 지키는 전 시스템 ON — 참여형 수비 등록 큐 + 건강도(전쟁 전용 HP 이월·치료소 회복) + 약탈(수비
# 큐 1번→금고 50%) + 정복(큐 전원+성벽 누적공성→함락·마을 tier 1↓) + 영주(세금 6h 수확·10%개인/
# 90%길드) + 명예(수비/입금→명예상점). 점령 중 세금이 거점 금고에 누적되고, 적 길드 거점 점령은
# 옛 3:3 토너먼트 대신 새 /attack(약탈/정복)으로 일원화(claim PvP 경로 차단·레거시 금고회수 404).
# 되돌리려면 false/제거 후 재배포 — 옛 토너먼트 코드는 PR-6b 제거 전까지 남아 폴백(flag-off=현행 복귀).
# NEXT_PUBLIC_ 라 빌드타임 베이크 — 값 변경 시 재빌드 필수.
NEXT_PUBLIC_V2_SETTLEMENT_WARFARE=true

# 타일 전쟁 ON (공존 컷오버) — 정착지 전쟁(약탈/정복/수비/영주/명성)을 자유 타일(tile:col,row)
# 위로 이전(브릿지=tileWarfare.ts·합성 거점 id 로 옛 전쟁 엔진 재사용). 길드원이 빈 땅 개척 시
# 길드 점령행 생성 + 영토 사냥세가 그 타일 금고로 + /outpost/tile:c,r 에서 약탈/정복/수비/영주.
# 결정=공존 — 옛 거점(카탈로그) 전쟁은 그대로 유지(은퇴·개인타일 백필은 후속). 롤백=false/제거 후 재배포.
# NEXT_PUBLIC_ 라 빌드타임 베이크 — 값 변경 시 재빌드 필수.
NEXT_PUBLIC_V2_TILE_WARFARE=true

# 타일 생산 관리 ON (T3b 컷오버) — 타일 정착지 승격을 지도 버튼이 아니라 기존 마을 생산
# 시스템으로(합성 id tile:col,row 로 outpost_villages 재사용). 흐름: 개척마을 생성(지도)
# → 관리(/outpost/tile:c,r)에서 마을 건설→슬롯 해금(골드)·생산(12h)·수확→자원으로 도시/대도시.
# 솔로=개인 자원 풀+본인 골드, 길드=길드 풀+길드 금고. 지도 승격 버튼/액션은 폐지(생산 관리로).
# 마이그 0079 가 옛 단순승격 타일을 생산 시스템에 비파괴 백필. 롤백=false/제거 후 재배포.
# NEXT_PUBLIC_ 라 빌드타임 베이크 — 값 변경 시 재빌드 필수.
NEXT_PUBLIC_V2_TILE_PRODUCTION=true

# 전역 EXP 배율 (leveling.ts) — 미설정이라 코어 루프 기본 2.5 (CORE_LOOP_XP_RATE, 캘리브
# 페이스: 베테랑 루프 ~1200판)가 적용된다. 옛 테스트 가속(4.0) 제거.
# ⚠️ 박스 .env.production.local 에 NEXT_PUBLIC_XP_RATE_MULT 가 있으면 그게 우선 — 2.5 적용하려면
#    .local 의 값도 함께 제거해야 한다. flag 를 되돌리면 XP 도 재설정 필요(미설정 시 1.0).

# 자유 타일 지도 ON (go-live) — /map 을 옛 ContinentMap → 새 9×9 타일 보드(TileMap)로 교체.
# 9거점(옛 id 재사용·점령/금고/세이브 자연승계) + 빈 땅 자유 이동 + 어디든 개척마을 정착
# (건설/마을승격=영지획득/도시/대도시) + 정착지 idle 골드 생산·수확 + 보드 밖 14거점 이동 목록.
# 결정=공존 — 옛 전쟁(/battle/war 자체 작전지도)·정착지 시스템은 그대로 살아있다(파괴 마이그 없음).
# 되돌리려면 false/제거 후 재배포 → 즉시 옛 ContinentMap 복귀(tile_settlements 테이블은 보존).
# NEXT_PUBLIC_ 라 빌드타임 베이크 — 값 변경 시 재빌드 필수.
NEXT_PUBLIC_V2_FREEFORM_TILES=true
