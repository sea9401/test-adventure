# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
# 로컬 미리보기·보고서·일회성 운영 출력물
/artifacts/
# 이미지 생성 원본 등 로컬 작업용 임시 산출물
/tmp/

# next.js
/.next/
/.next-*/
/out/

# production
/build
/.edge-state/

# misc
.DS_Store
*.pem
# 1회용 쿠폰 평문이 들어가는 운영 출력물
/beta-coupons*.csv

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
# 비밀 아님 — 빌드 타임에 굽는 공개 페이싱 다이얼. 박스 .env.production.local 이
# 이 키를 안 가져서 충돌 없음(.local 우선순위). 값 튜닝은 이 파일 한 줄 수정 + push.
!.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# clerk configuration (can include secrets)
/.clerk/

# Windows 다운로드 ADS 마커 정크 (이미지 등 받을 때 따라옴)
*:Zone.Identifier
