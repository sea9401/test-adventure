[Unit]
Description=Adventure RPG disposable database restore verification
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/ec2-user/adventure-rpg
ExecStart=/usr/bin/bash deploy/run-restore-test.sh
Environment=PRODUCTION_ENV_PATH=/run/adventure-rpg/production.env
User=ec2-user
Group=ec2-user
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ec2-user/backups
RestrictSUIDSGID=true
