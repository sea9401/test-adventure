[Unit]
Description=Adventure RPG resource monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/ec2-user/adventure-rpg
ExecStart=/usr/bin/bash deploy/check-resources.sh
Environment=RESOURCE_MONITOR_STATE_PATH=/var/lib/adventure-resource-monitor/state
Environment=RDS_MEMORY_MONITOR_STATE_PATH=/var/lib/adventure-resource-monitor/rds-memory-state.json
Environment=OPS_HEARTBEAT_DIR=/var/lib/adventure-resource-monitor/heartbeats
Environment=OPS_HEARTBEAT_ALERT_STATE_PATH=/var/lib/adventure-resource-monitor/heartbeat-alert-state.json
Environment=OPS_HEARTBEAT_RULES_PATH=/home/ec2-user/adventure-rpg/deploy/ops-heartbeats.json
User=ec2-user
Group=ec2-user
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
StateDirectory=adventure-resource-monitor
StateDirectoryMode=0700
RestrictSUIDSGID=true
