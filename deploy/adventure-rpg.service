# /etc/systemd/system/adventure-rpg.service
# Next.js 프로덕션 서버를 항상 가동 + 죽으면 자동 재시작 + 서버 부팅 시 자동 시작.
# 환경변수는 .env.production.local 에 두면 `next start` 가 알아서 로드한다 (EnvironmentFile 불필요).
[Unit]
Description=Adventure RPG
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ec2-user/adventure-rpg
ExecStart=/usr/bin/npm start
# `npm start` exits with SIGTERM (128 + 15) during an intentional systemctl
# stop/restart. Treat that as a clean shutdown so routine deploys do not leave
# a misleading failed result in the journal.
SuccessExitStatus=143
Restart=always
RestartSec=3
MemoryHigh=1200M
MemoryMax=1536M
TasksMax=256
LimitNOFILE=65536
User=ec2-user
Group=ec2-user
StandardOutput=journal
StandardError=journal
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ec2-user/adventure-rpg/.next
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
