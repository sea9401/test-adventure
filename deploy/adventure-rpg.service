# /etc/systemd/system/adventure-rpg.service
# Next.js 프로덕션 서버를 항상 가동 + 죽으면 자동 재시작 + 서버 부팅 시 자동 시작.
# SSM 런타임 파일과 푸시 전용 환경 파일을 systemd가 읽어 Node에 전달한다.
[Unit]
Description=Adventure RPG
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ec2-user/adventure-rpg
RuntimeDirectory=adventure-rpg
RuntimeDirectoryMode=0700
ExecStartPre=/usr/bin/node /usr/local/libexec/adventure-rpg/sync-production-env-from-ssm.mjs /run/adventure-rpg/production.env
ExecStartPre=/bin/bash -c 'set -a; source /run/adventure-rpg/production.env; source /etc/adventure-rpg/web-push.env; exec /usr/bin/node /home/ec2-user/adventure-rpg/scripts/check-production-env.mjs'
ExecStart=/bin/bash -c 'set -a; source /run/adventure-rpg/production.env; source /etc/adventure-rpg/web-push.env; exec /usr/bin/node /home/ec2-user/adventure-rpg/node_modules/next/dist/bin/next start'
# Intentional stop/restart의 SIGTERM을 정상 종료로 취급한다.
SuccessExitStatus=143
Restart=always
RestartSec=3
MemoryHigh=1200M
MemoryMax=1536M
TasksMax=256
LimitNOFILE=65536
User=ec2-user
Group=ec2-user
StandardOutput=journal
StandardError=journal
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ec2-user/adventure-rpg/.next
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
