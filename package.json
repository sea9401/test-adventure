{
  "name": "adventure-rpg",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run optimize-images && npm run check-images",
    "dev": "next dev",
    "prebuild": "npm run optimize-images && npm run check-images",
    "build": "next build",
    "postbuild": "node scripts/fix-next-route-group-manifests.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "knip": "knip --no-exit-code",
    "optimize-images": "node scripts/optimize-images.mjs",
    "check-images": "node scripts/check-images.mjs",
    "check-migrations": "node scripts/check-migrations.mjs",
    "account:create": "node scripts/create-password-account.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node src/db/migrate.mjs",
    "db:baseline-mark": "node src/db/baseline-mark.mjs"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@aws-sdk/client-s3": "^3.1088.0",
    "@phosphor-icons/react": "^2.1.10",
    "drizzle-orm": "^0.45.2",
    "next": "16.2.11",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.13.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.11.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "knip": "^6.23.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-arm64-gnu": "4.2.4",
    "lightningcss-linux-arm64-gnu": "1.32.0"
  },
  "overrides": {
    "postcss": "8.5.14",
    "sharp": "$sharp"
  }
}
